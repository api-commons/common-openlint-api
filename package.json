{
  "name": "@api-common/common-openlint-api",
  "version": "1.1.0",
  "description": "The API Commons OpenLint API: a small OpenAPI-first HTTP API to lint API artifacts, list rules/rulesets, and validate rulesets over HTTP. Runs the @openlint engine.",
  "type": "module",
  "bin": {
    "common-openlint-api": "src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "lint:self": "node src/selfcheck.mjs",
    "check": "npm run lint:self"
  },
  "license": "Apache-2.0",
  "repository": "github:api-commons/common-openlint-api",
  "dependencies": {
    "@openlint/openlint-core": "^0.0.1",
    "@openlint/openlint-formats": "^0.0.1",
    "@openlint/openlint-functions": "^0.0.1",
    "@openlint/openlint-parsers": "^1.0.0",
    "@openlint/openlint-rulesets": "^0.0.1",
    "fastify": "^5.2.0",
    "yaml": "^2.6.1"
  },
  "private": true
}
